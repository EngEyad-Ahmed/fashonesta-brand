# Backend server
PORT=4000

# MySQL (phpMyAdmin) connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fashionista
DB_POOL_LIMIT=10

# JWT (important: change to a long random secret)
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Salt rounds for bcrypt
BCRYPT_ROUNDS=10